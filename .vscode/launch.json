{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch AETHER Browser",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start"
    },
    {
      "name": "Debug Main Process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe",
      "args": ["."],
      "outputCapture": "std"
    }
  ]
}
