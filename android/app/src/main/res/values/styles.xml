<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AETHERBrowser" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="alertDialogTheme">@style/Theme.AETHERDialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.AETHERDialog</item>
    </style>

    <style name="Theme.AETHERDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:background">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/AetherDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/AetherDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/AetherDialogButton</item>
    </style>

    <style name="AetherDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/accent</item>
    </style>
</resources>

